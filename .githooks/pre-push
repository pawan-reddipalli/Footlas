#!/usr/bin/env bash
# Runs the local CI checks before every push. Installed by `./scripts/ci-local.sh --install-hook`.
# Skip once with `git push --no-verify`, or set SKIP_LOCAL_CI=1.
set -euo pipefail

if [ "${SKIP_LOCAL_CI:-0}" = 1 ]; then
  echo "SKIP_LOCAL_CI=1, skipping local CI."
  exit 0
fi

# Pushing only deletes a branch? Nothing to check.
zero=0000000000000000000000000000000000000000
has_commits=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" != "$zero" ] && has_commits=1
done
[ "$has_commits" = 1 ] || exit 0

# The checks run on your working tree, so uncommitted changes count. Warn about that.
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "Note: you have uncommitted changes; local CI checks the working tree, not just what you push."
fi

exec "$(git rev-parse --show-toplevel)/scripts/ci-local.sh"
