# Copy to .env and adjust.
DATABASE_URL=postgresql+psycopg://footlas:footlas@localhost:5434/footlas

# "dev" trusts an X-Dev-User header (local only). "clerk" verifies Clerk session tokens.
AUTH_MODE=dev
ENVIRONMENT=development

# Required when AUTH_MODE=clerk: your Clerk Frontend API URL, from the Clerk dashboard
# (Configure > API keys), e.g. https://your-app.clerk.accounts.dev
CLERK_ISSUER=
# Optional. Defaults to $CLERK_ISSUER/.well-known/jwks.json, which is right for Clerk.
CLERK_JWKS_URL=
# Comma-separated origins allowed in the token's azp claim, e.g. https://footlas.app
CLERK_AUTHORIZED_PARTIES=

CORS_ORIGINS=http://localhost:3000
